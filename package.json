{
  "name": "apnw",
  "version": "0.1.0",
  "private": true,
  "description": "Apple Push Notification Worker for Cloudflare",
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test",
    "deploy:dev": "wrangler deploy --env=\"\"",
    "deploy:production": "wrangler deploy --env production --var SERVICE_VERSION:$(git rev-parse --verify HEAD)",
    "dev": "wrangler dev",
    "test": "vitest run",
    "load-test": "node scripts/load-test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@cloudflare/workers-types": "5.20260726.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@peculiar/x509": "^2.0.0",
    "asn1js": "^3.0.10",
    "cbor-x": "^1.6.4",
    "pkijs": "^3.4.1",
    "reflect-metadata": "^0.2.2"
  }
}
